# EW Machine Hire — environment variable placeholders
# Copy to .env.local for local development.
# Never commit real secrets. Never expose the service-role key to the client.

# -----------------------------------------------------------------------------
# Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EW Machine Hire
# Local: http://localhost:3000
# Staging Path A (default, zero DNS): https://<site-name>.netlify.app
# Optional Path B later only: https://machinehire.ew.com.zm
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=machinehire@ew.com.zm

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser / client key — set ONE of these (both are the public client key):
# Classic dashboard name:
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Newer dashboard "publishable" name (accepted as an alias by the app):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
#
# Resolution: if ANON_KEY is set to a non-placeholder value it wins;
# otherwise PUBLISHABLE_KEY is used. Do not put the service-role secret here.

# -----------------------------------------------------------------------------
# Server-only (do NOT prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Required for privileged server operations (admin client, some setup scripts).
# Not required for normal user sign-in / session / RLS-backed queries.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: database URL for migrations / tooling (local or pooled)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
#
# Capacity harness (scripts/seed-capacity-demo.mjs, scripts/measure-usage.mjs):
# Prefer a local or staging DB. Never commit real passwords.
# CAPACITY_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ewm_capacity_demo
#
# Optional Supabase Management API for live project filesize (server/scripts only):
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# -----------------------------------------------------------------------------
# Auth / local development (Phase 2)
# -----------------------------------------------------------------------------
# When Supabase is not configured, set true to browse the shell without a session.
# NEVER enable in production or staging. Prefer false once URL + client key are set.
DEV_ALLOW_UNCONFIGURED_SHELL=true

# -----------------------------------------------------------------------------
# Email / SMTP (Auth)
# -----------------------------------------------------------------------------
# Prefer Supabase Dashboard → Authentication → custom SMTP with the existing
# Titan mailbox (ew.com.zm). No app-side SMTP env is required for Auth invites
# or password resets. See docs/EMAIL_SMTP.md.
# Dashboard / Management API field names (set in Dashboard only — never paste
# passwords into chat or commit them):
#   smtp_host, smtp_port, smtp_user, smtp_pass, smtp_admin_email, smtp_sender_name
# Titan (documented): host smtp.titan.email ; port 587 STARTTLS or 465 SSL.
# NEXT_PUBLIC_SUPPORT_EMAIL above is display/contact only — not an SMTP password.
#
# Scheduled DB backups use scripts/backup/backup.env (gitignored), not this file.
# See docs/BACKUP_RECOVERY.md and scripts/backup/backup.env.example.

# -----------------------------------------------------------------------------
# Feature flags / future (Proposed)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true
# Do not use a paid EMAIL_PROVIDER_API_KEY for Auth under the zero-fee preference.
# # EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_KEY
