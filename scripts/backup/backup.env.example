# Copy to backup.env on the company computer that runs scheduled exports.
# NEVER commit backup.env. Path is gitignored.
#
# Load:  set -a; source /path/to/scripts/backup/backup.env; set +a
# Or:    export $(grep -v '^#' backup.env | xargs)   # careful with spaces

# Required: Postgres URI from Supabase → Project Settings → Database
# Prefer the direct or session-mode URI for dumps (not transaction pooler if dump fails).
# Do not paste the real password into chat or tickets.
SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Where archives are written (outside the git checkout strongly preferred)
# Example Linux:  /var/backups/ew-machine-hire
# Example Windows: D:\Backups\EW-MachineHire
EWM_BACKUP_ROOT=

# Optional labels
EWM_BACKUP_PROJECT=staging
EWM_BACKUP_RETENTION_DAILY=7
EWM_BACKUP_RETENTION_WEEKLY=4

# Optional: path to a failure marker / log (defaults under EWM_BACKUP_ROOT/logs)
# EWM_BACKUP_LOG_DIR=

# Optional: notify on failure by appending to a watched file or calling a local hook.
# Leave empty for file-only failure reporting (no paid SaaS).
# EWM_BACKUP_FAILURE_HOOK=
