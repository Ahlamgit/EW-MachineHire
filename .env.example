# EW Machine Hire — environment variable placeholders
# Copy to .env.local for local development.
# Never commit real secrets. Never expose the service-role key to the client.

# -----------------------------------------------------------------------------
# Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EW Machine Hire
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=machinehire@ew.com.zm

# Supabase — anon/public key only on the client
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Server-only (do NOT prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Used exclusively in server environments (Route Handlers, Server Actions, CI).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: database URL for migrations / tooling (local or pooled)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# -----------------------------------------------------------------------------
# Feature flags / future (Proposed — unused in Phase 1)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true
# EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_KEY
