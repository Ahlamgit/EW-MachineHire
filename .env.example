# EW Machine Hire — environment variable placeholders
# Copy to .env.local for local development.
# Never commit real secrets. Never expose the service-role key to the client.

# -----------------------------------------------------------------------------
# Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EW Machine Hire
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=machinehire@ew.com.zm

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser / client key — set ONE of these (both are the public client key):
# Classic dashboard name:
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Newer dashboard "publishable" name (accepted as an alias by the app):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
#
# Resolution: if ANON_KEY is set to a non-placeholder value it wins;
# otherwise PUBLISHABLE_KEY is used. Do not put the service-role secret here.

# -----------------------------------------------------------------------------
# Server-only (do NOT prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Required for privileged server operations (admin client, some setup scripts).
# Not required for normal user sign-in / session / RLS-backed queries.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: database URL for migrations / tooling (local or pooled)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# -----------------------------------------------------------------------------
# Auth / local development (Phase 2)
# -----------------------------------------------------------------------------
# When Supabase is not configured, set true to browse the shell without a session.
# NEVER enable in production or staging. Prefer false once URL + client key are set.
DEV_ALLOW_UNCONFIGURED_SHELL=true

# -----------------------------------------------------------------------------
# Feature flags / future (Proposed)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true
# EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_KEY
